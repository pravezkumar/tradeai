# TradeAI backend environment example
# Never commit real secrets. Configure them in Render Environment.

DATABASE_URL=postgresql://...
TRADEAI_ENV=development
TRADEAI_QUALIFIED_THRESHOLD=60
TRADEAI_OTP_TTL_MINUTES=10
TRADEAI_OTP_COOLDOWN_SECONDS=60
TRADEAI_OTP_SECRET=replace-with-a-long-random-secret
TRADEAI_DEV_OTP=1234

# Buyer OTP over normal SMS (MSG91)
TRADEAI_MSG91_AUTH_KEY=
TRADEAI_MSG91_SMS_TEMPLATE_ID=
TRADEAI_MSG91_OTP_VAR=OTP

# OpenAI buyer qualification
OPENAI_API_KEY=
TRADEAI_OPENAI_MODEL=gpt-5.6-luna
TRADEAI_AI_MODE=auto

# WhatsApp Business Cloud API (supplier RFQ notifications; buyer OTP does not use WhatsApp)
TRADEAI_WHATSAPP_ACCESS_TOKEN=
TRADEAI_WHATSAPP_PHONE_NUMBER_ID=
TRADEAI_META_GRAPH_VERSION=v25.0
TRADEAI_WA_RFQ_TEMPLATE=
TRADEAI_WA_RFQ_LANGUAGE=en_US
TRADEAI_WA_VERIFY_TOKEN=
TRADEAI_META_APP_SECRET=

# Internal/admin
TRADEAI_ADMIN_TOKEN=
TRADEAI_ROUTING_TOKEN=
TRADEAI_CORS_ORIGINS=https://tradeai-pgvr.onrender.com
